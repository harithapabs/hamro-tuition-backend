# Copy this file to .env and fill in values

# REQUIRED in production
JWT_SECRET=please-generate-a-random-32-char-secret
NODE_ENV=production
PORT=5000

# MongoDB Atlas (required for production database)
# Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/hamrotuition?retryWrites=true&w=majority

# Cloudinary (required for file storage - videos, PDFs, images)
# Get from: https://cloudinary.com/ (free, no credit card)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Comma-separated list of allowed origins for CORS
# Add your Firebase/Vercel frontend URL here in production:
ALLOWED_ORIGINS=https://hamrotuition.web.app,https://hamrotuition.firebaseapp.com,https://hamrotuition.com,https://www.hamrotuition.com

# Optional: Sentry error monitoring
# SENTRY_DSN=https://...@sentry.io/...

# Optional: SMTP for sending emails (verification, 2FA, password reset, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@hamrotuition.com
